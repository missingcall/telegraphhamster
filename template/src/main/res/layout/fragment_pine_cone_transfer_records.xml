<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_bg_achievement">

    <include layout="@layout/fast_layout_title_bar" />

    <Button
        android:id="@+id/btn_date_start"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_25"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginTop="@dimen/margin_10"
        android:background="@drawable/shape_btn_bg_radius"
        android:paddingLeft="@dimen/margin_5"
        android:paddingRight="@dimen/margin_5"
        android:text="选择开始日期"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_date_end"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_25"
        android:background="@drawable/shape_btn_bg_radius"
        android:paddingLeft="@dimen/margin_5"
        android:paddingRight="@dimen/margin_5"
        android:text="选择结束日期"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_10"
        android:layout_marginLeft="@dimen/margin_5"
        app:layout_constraintBottom_toBottomOf="@id/btn_date_start"
        app:layout_constraintLeft_toRightOf="@id/btn_date_start"
        app:layout_constraintTop_toTopOf="@id/btn_date_start" />

    <Button
        android:id="@+id/btn_date_select"
        android:layout_width="@dimen/width_60"
        android:layout_height="@dimen/height_25"
        android:layout_marginRight="@dimen/margin_10"
        android:background="@drawable/shape_btn_bg_radius_blue"
        android:text="查询"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="@dimen/text_size_10"
        app:layout_constraintBottom_toBottomOf="@id/btn_date_start"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_date_start" />


    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/smartLayout_rootFastLib"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_date_start">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_contentFastLib"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="5dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@id/guideline_vertical"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:itemCount="10"
            tools:listitem="@layout/item_pine_cone_transfer_records" />

    </com.scwang.smart.refresh.layout.SmartRefreshLayout>


</androidx.constraintlayout.widget.ConstraintLayout>